# Copy to .env and edit. Everything here has a default in utils/config.py, so
# a fresh checkout runs without this file at all.
#
#   cp .env.example .env

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Temporal ---
# host:port of the frontend service. Inside a container this is not
# "localhost": that is the container itself. Use the service name.
TEMPORAL_HOST=localhost:7234
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nafas_queue

# Run the worker inside the API process. Convenient on a laptop; leave it
# false anywhere a separate worker is running, or both will poll the same
# queue and a version skew between them will corrupt payloads in silence.
RUN_WORKER_IN_API=false

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local scratch ---
# disposable; gitignored
TEMP_DIR=assets
