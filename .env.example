# Copy to .env and edit. Everything here has a default in utils/config.py, so
# a fresh checkout runs without this file at all.
#
#   cp .env.example .env

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Temporal ---
# host:port of the frontend service. Inside a container this is not
# "localhost": that is the container itself. Use the service name.
TEMPORAL_HOST=localhost:7234
TEMPORAL_NAMESPACE=default
# task queues are fixed per service (nafas_core.temporal.TaskQueue), not configured

# --- Database ---
# docker-compose publishes Postgres on 5433. Services connect as nafas_service,
# which row-level security applies to; migrations run as the owner.
DATABASE_URL=postgresql+asyncpg://nafas_service:nafas@localhost:5433/nafas
DATABASE_OWNER_URL=postgresql+asyncpg://nafas:nafas@localhost:5433/nafas

# --- Object storage (S3 API; SeaweedFS locally) ---
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=nafas
S3_SECRET_KEY=nafas-secret
S3_BUCKET=nafas

# --- Claude ---
ANTHROPIC_API_KEY=
LLM_CHAT_MODEL=claude-sonnet-5
LLM_CLASSIFIER_MODEL=claude-haiku-4-5
LLM_SUMMARY_MODEL=claude-opus-5-5

# --- LangSmith tracing ---
# Off unless LANGSMITH_TRACING=true and a key is set. Traces hold prompts, and
# prompts hold patient data: hide inputs/outputs, or self-host, before any
# real patient uses the system.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nafas-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# --- Dialect router (GPU service) ---
DIALECT_ROUTER_URL=http://localhost:8410

# --- Telegram (patient bot) ---
TELEGRAM_BOT_TOKEN=
# any random string; Telegram echoes it in a header on every webhook call
TELEGRAM_WEBHOOK_SECRET=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Service-to-service ---
# every internal API checks X-Internal-Token against this; empty refuses all calls
INTERNAL_API_TOKEN=
IDENTITY_URL=http://localhost:8010

# --- Doctor dashboard auth ---
# required before the auth routes run: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_TTL_MINUTES=720

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local scratch ---
# disposable; gitignored
TEMP_DIR=assets
