# Copy to .env and edit. Everything here has a default in utils/config.py, so
# a fresh checkout runs without this file at all.
#
#   cp .env.example .env

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Temporal ---
# host:port of the frontend service. Inside a container this is not
# "localhost": that is the container itself. Use the service name.
TEMPORAL_HOST=localhost:7234
TEMPORAL_NAMESPACE=default
# task queues are fixed per service (nafas_core.temporal.TaskQueue), not configured

# --- Database ---
# docker-compose publishes Postgres on 5433. Services connect as nafas_service,
# which row-level security applies to; migrations run as the owner.
DATABASE_URL=postgresql+asyncpg://nafas_service:nafas@localhost:5433/nafas
DATABASE_OWNER_URL=postgresql+asyncpg://nafas:nafas@localhost:5433/nafas

# --- Object storage (S3 API; SeaweedFS locally) ---
S3_ENDPOINT_URL=http://localhost:8333
# the store as browsers reach it (upload and download links); empty: S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=nafas
S3_SECRET_KEY=nafas-secret
S3_BUCKET=nafas

# --- LLM ---
# `ollama` is the default local provider. It exposes an OpenAI-compatible API.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=gemma4:e4b
LLM_CLASSIFIER_MODEL=gemma4:e4b
LLM_SUMMARY_MODEL=gemma4:e4b

# --- Claude (used only when LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# only for a key not scoped to a workspace (the API says so with a 400)
ANTHROPIC_WORKSPACE_ID=

# --- Web search (Tavily), to ground chat answers in published sources ---
# Paste the key here; empty turns web search off everywhere. The doctor's
# assistant gets a search tool; patients' general answers use trusted medical
# sites only, and only with WEB_SEARCH_PATIENT=true. Queries never carry the
# patient's own words: they are rewritten without personal details first.
TAVILY_API_KEY=
WEB_SEARCH_DOCTOR=true
WEB_SEARCH_PATIENT=false

# --- LangSmith tracing ---
# Off unless LANGSMITH_TRACING=true and a key is set. Traces hold prompts, and
# prompts hold patient data: hide inputs/outputs, or self-host, before any
# real patient uses the system.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nafas-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# --- Dialect router (GPU service) ---
DIALECT_ROUTER_URL=http://localhost:8410
STT_URL=http://localhost:8420
TTS_URL=http://localhost:8440
# bge-m3 for per-patient search; self_hosted is the embeddings service below
EMBEDDINGS_PROVIDER=self_hosted
EMBEDDINGS_URL=http://localhost:8430
CLINICAL_URL=http://localhost:8050
DOCTOR_ASSISTANT_URL=http://localhost:8020

# --- Service-to-service ---
# every internal API checks X-Internal-Token against this; empty refuses all calls
INTERNAL_API_TOKEN=
IDENTITY_URL=http://localhost:8010
SCHEDULING_URL=http://localhost:8030
CONVERSATION_URL=http://localhost:8040

# --- Email (appointment notices); empty SMTP_HOST sends none ---
# `make up` runs Mailpit: SMTP on :1025 without TLS, the inbox at http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=Nafas <no-reply@nafas.local>
WEB_URL=http://localhost:8088

# --- Doctor dashboard auth ---
# required before the auth routes run: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
# the proxies whose X-Forwarded-For the gateway trusts (rate limits key on the client address)
FORWARDED_ALLOW_IPS=127.0.0.1
JWT_TTL_MINUTES=720

# --- Logging ---
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local scratch ---
# disposable; gitignored
TEMP_DIR=assets
